# ==============================================================================
# NUTCI - 3ª Gerência Regional de Educação (SEE-PB)
# Copie este arquivo para ".env" localmente e preencha com a URL do Neon.tech.
# No Render.com, adicione essas variáveis em: Dashboard -> Environment -> Env Vars.
# ==============================================================================

FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=troque-por-uma-chave-secreta-forte-e-aleatoria

# String de conexão PostgreSQL do Neon.tech
DATABASE_URL=postgresql://SEU_USUARIO:SUA_SENHA@SEU_HOST.neon.tech/neondb?sslmode=require

PORT=5000
